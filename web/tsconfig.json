{
  "compilerOptions": {
    "target": "ES2020", // Upgrade dari ES2017 ke ES2020 untuk dukungan fitur modern
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true, // Tambahkan untuk konsistensi nama file
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext", // Gunakan "ESNext" untuk dukungan module yang lebih baik
    "moduleResolution": "bundler", // Pertahankan untuk kompatibilitas dengan bundler modern
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx", // Pertahankan untuk dukungan JSX di Next.js
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    // Tambahkan pengaturan berikut untuk dukungan TypeScript yang lebih baik
    "baseUrl": ".", // Atur baseUrl untuk path yang relatif
    "noUnusedLocals": true, // Laporkan variabel lokal yang tidak digunakan
    "noUnusedParameters": true, // Laporkan parameter yang tidak digunakan
    "noFallthroughCasesInSwitch": true // Laporkan kesalahan fallthrough di switch
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules"
  ]
}
